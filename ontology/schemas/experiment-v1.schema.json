{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sguzman.github.io/sceneology/ontology/schemas/experiment-v1.schema.json",
  "title": "Sceneology reproducible experiment v1",
  "description": "Test record; status is a technical finding and does not confer artistic gallery approval or public admission.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "question",
    "hypothesis",
    "method",
    "inputs",
    "observations",
    "outcome",
    "status",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "hypothesis": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "description"
        ],
        "properties": {
          "kind": {
            "enum": [
              "measurement",
              "visual",
              "runtime",
              "human-evaluation",
              "unknown"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "outcome": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "passed",
        "failed",
        "inconclusive",
        "blocked"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reproduction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        }
      }
    },
    "related_scene_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "provenance": {
      "type": "string",
      "description": "Only rights-cleared public provenance and technical source references."
    }
  }
}
