{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sguzman.github.io/sceneology/ontology/schemas/scene-v1.schema.json",
  "title": "Sceneology Scene v1",
  "description": "Renderer-independent authored scene description; representation does not establish a successful rendering or artist approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "dimension",
    "units",
    "frame",
    "elements",
    "relations",
    "constraints",
    "presentation",
    "realization"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "dimension": {
      "enum": [
        "2d",
        "3d"
      ]
    },
    "units": {
      "enum": [
        "px",
        "m",
        "unit"
      ]
    },
    "frame": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "depth": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/constraint"
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "background",
        "draw_order",
        "style"
      ],
      "properties": {
        "background": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "draw_order": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "style": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "palette": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^#[0-9a-fA-F]{6}$"
              }
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "camera_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "timeline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fps",
        "duration_seconds",
        "tracks"
      ],
      "properties": {
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "duration_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "loop": {
          "type": "boolean"
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/input"
      }
    },
    "effects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/effect"
      }
    },
    "audio_cues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/audioCue"
      }
    },
    "realization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "engine",
        "assets"
      ],
      "properties": {
        "kind": {
          "enum": [
            "declarative-only",
            "authored-raster",
            "authored-vector",
            "constructive",
            "procedural",
            "hybrid"
          ]
        },
        "engine": {
          "type": "string",
          "minLength": 1
        },
        "assets": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "vector": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {
        "type": "number"
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "shape",
        "transform"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "object",
            "character",
            "environment",
            "camera",
            "light",
            "emitter",
            "controller"
          ]
        },
        "parent_id": {
          "$ref": "#/$defs/id"
        },
        "shape": {
          "enum": [
            "rectangle",
            "ellipse",
            "polygon",
            "sprite",
            "box",
            "sphere",
            "mesh-reference",
            "none"
          ]
        },
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "position",
            "scale",
            "rotation"
          ],
          "properties": {
            "position": {
              "$ref": "#/$defs/vector"
            },
            "scale": {
              "$ref": "#/$defs/vector"
            },
            "rotation": {
              "type": "number"
            },
            "opacity": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "visible": {
              "type": "boolean"
            }
          }
        },
        "size": {
          "$ref": "#/$defs/vector"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "asset_id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_id",
        "predicate",
        "object_id"
      ],
      "properties": {
        "subject_id": {
          "$ref": "#/$defs/id"
        },
        "predicate": {
          "enum": [
            "inside",
            "adjacent-to",
            "supported-by",
            "attached-to",
            "occludes",
            "in-front-of",
            "interacts-with"
          ]
        },
        "object_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "subject_id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "within-frame",
            "nonoverlap",
            "fixed-position",
            "relative-order"
          ]
        },
        "subject_id": {
          "$ref": "#/$defs/id"
        },
        "object_id": {
          "$ref": "#/$defs/id"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "time_seconds",
        "value"
      ],
      "properties": {
        "time_seconds": {
          "type": "number",
          "minimum": 0
        },
        "value": {
          "oneOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "$ref": "#/$defs/vector"
            }
          ]
        }
      }
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "property",
        "interpolation",
        "keyframes"
      ],
      "properties": {
        "target_id": {
          "$ref": "#/$defs/id"
        },
        "property": {
          "enum": [
            "position",
            "scale",
            "rotation",
            "opacity",
            "visible"
          ]
        },
        "interpolation": {
          "enum": [
            "linear",
            "step"
          ]
        },
        "keyframes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/keyframe"
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "trigger",
        "target_id",
        "action"
      ],
      "properties": {
        "event": {
          "enum": [
            "key",
            "click",
            "pointer-enter"
          ]
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "target_id": {
          "$ref": "#/$defs/id"
        },
        "action": {
          "enum": [
            "toggle-visibility",
            "set-opacity",
            "play-timeline",
            "pause-timeline"
          ]
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target_id",
        "kind",
        "parameters"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "target_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "glow",
            "wind",
            "rain",
            "shader"
          ]
        },
        "parameters": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      }
    },
    "audioCue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target_id",
        "event",
        "asset_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "target_id": {
          "$ref": "#/$defs/id"
        },
        "event": {
          "enum": [
            "enter",
            "click",
            "timeline"
          ]
        },
        "asset_id": {
          "$ref": "#/$defs/id"
        }
      }
    }
  }
}
